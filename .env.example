# ---------------------------------------------------------------------------
# Copie este archivo a .env y complete los valores antes de `docker compose up`
# ---------------------------------------------------------------------------

# Puerto donde se publica la aplicación web (http://localhost:8090)
APP_PORT=8090

# Base de datos (PostgreSQL interno, no se expone fuera de Docker)
DB_NAME=atrepresentaciones
DB_USER=atrep
DB_PASSWORD=cambiar-por-una-clave-segura

# Seguridad: cadena aleatoria de 32+ caracteres (ej.: openssl rand -hex 32)
JWT_SECRET=cambiar-por-una-cadena-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_HOURS=10
# true si se publica detrás de HTTPS
COOKIE_SECURE=false

# Usuario administrador creado en el primer arranque (si no hay usuarios)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Respaldos diarios en ./backups
BACKUP_RETENTION_DAYS=14

LOG_LEVEL=info
